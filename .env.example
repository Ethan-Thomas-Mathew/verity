# Copy to .env. Every value here is the default, so the file is optional.
VERITY_DATABASE_URL=postgresql+psycopg://verity:verity@127.0.0.1:5433/verity
VERITY_TARGET_URL=http://127.0.0.1:8001

# Local model through Ollama (no key). Pull the models first:
#   ollama pull qwen2.5:7b
#   ollama pull nomic-embed-text
VERITY_LLM_PROVIDER=ollama
VERITY_LLM_MODEL=qwen2.5:7b
VERITY_EMBEDDING_PROVIDER=ollama

# To use a hosted model instead, set the provider and its key, for example:
# VERITY_LLM_PROVIDER=gemini
# VERITY_GEMINI_API_KEY=
# VERITY_LLM_PROVIDER=openai
# VERITY_OPENAI_API_KEY=
# VERITY_LLM_PROVIDER=anthropic
# VERITY_ANTHROPIC_API_KEY=

# Save every model reply so a run can be replayed later with VERITY_LLM_PROVIDER=replay.
# VERITY_RECORD_DIR=eval/recordings
